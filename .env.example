# Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_MAX_DOCUMENT_BYTES=52428800

# GitHub — target repository the coding agent works in
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_WEBHOOK_SECRET=

# Один официальный логин coding agent (назначение + комментарии + PR).
# Предположение про отдельный github-copilot[bot] — ошибочное, не используем.
COPILOT_USERNAME=copilot-swe-agent[bot]

# Предупреждение, если job в CODING_AGENT_RUNNING / WAIT_TESTS
# без событий дольше порога. Job в terminal не переводится.
CODING_AGENT_STALE_TIMEOUT_SEC=1800
CODING_AGENT_POLL_INTERVAL_SEC=30
CODING_AGENT_POLL_TIMEOUT_SEC=21600

# HTTP
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
